<Window x:Class="FirstJRPG.NicknameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstJRPG"
        mc:Ignorable="d"
        Height="200" Width="300"
        WindowStartupLocation="CenterOwner"
        KeyDown="NameTextBox_KeyDown">
    <StackPanel Margin="20">
        <TextBlock Text="Введите имя:" FontSize="16" Margin="0,0,0,10"/>
        <TextBox x:Name="NameTextBox" FontSize="14" Margin="0,0,0,15"/>
        <Button Content="OK" Width="80" HorizontalAlignment="Right" 
                Click="OkButton_Click"/>
    </StackPanel>
</Window>
