<Window x:Class="FirstJRPG.ClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstJRPG"
        mc:Ignorable="d"
        Title="Выбор класса" Height="400" Width="600">
    <Grid Margin="20">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Warrior" Width="150" HorizontalAlignment="Left" Click="ClassButton_Click" Margin="10"/>
            <Button Content="Wizard" Width="150" HorizontalAlignment="Left" Click="ClassButton_Click" Margin="10"/>
            <Button Content="Archery" Width="150" HorizontalAlignment="Left" Click="ClassButton_Click" Margin="10"/>
        </StackPanel>

        <TextBlock Grid.Column="1" Grid.Row="0" x:Name="DescriptionTextBlock" 
                   Text="Сильный и выносливый боец. Использует тяжелое оружие и доспехи." FontSize="14" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10"/>

        <Button Grid.Column="2" Content="OK" Width="100" HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" Click="OkButton_Click"/>
    </Grid>
</Window>
